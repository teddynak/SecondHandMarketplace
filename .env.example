# Copy to .env.local and replace values. NEVER commit .env.local.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/reuse_market?retryWrites=true&w=majority
# Generate with: openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG

# Administrator login. Run npm run setup-admin to create/update it.
ADMIN_EMAIL=nakteddy6@gmail.com
ADMIN_PASSWORD=REPLACE_WITH_YOUR_PRIVATE_ADMIN_PASSWORD

# Optional: separate password for seeded demo users. Defaults to ADMIN_PASSWORD.
# Minimum 8 characters, maximum 72 UTF-8 bytes.
# SEED_PASSWORD=REPLACE_WITH_YOUR_PRIVATE_DEMO_PASSWORD

# Canonical public origin; HTTPS in production. Also used by account email links and SEO.
APP_URL=http://localhost:3000
# Optional email delivery. Password change and in-app notifications need no email provider.
# Set all four email settings to enable recovery/verification; do not use a real key in source control.
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
EMAIL_FROM="ReUse Market <noreply@YOUR_VERIFIED_DOMAIN>"

# Optional prototype upload quotas: 4-500 images and 8-1024 MB per account.
# Existing uploads count toward limits; existing data is never deleted automatically.
IMAGE_MAX_PER_ACCOUNT=50
IMAGE_MAX_TOTAL_MB=64
