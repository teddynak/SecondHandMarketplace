# Copy to .env.local and replace values. NEVER commit .env.local.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/reuse_market?retryWrites=true&w=majority
# Generate with: openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG

# Administrator login. Run npm run setup-admin to create/update it.
ADMIN_EMAIL=nakteddy6@gmail.com
ADMIN_PASSWORD=REPLACE_WITH_YOUR_PRIVATE_ADMIN_PASSWORD

# Optional: separate password for seeded demo users. Defaults to ADMIN_PASSWORD.
# Minimum 8 characters, maximum 72 UTF-8 bytes.
# SEED_PASSWORD=REPLACE_WITH_YOUR_PRIVATE_DEMO_PASSWORD
